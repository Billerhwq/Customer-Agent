{
  "type": "object",
  "required": ["answer", "language", "confidence", "sources", "need_human", "lead_fields", "follow_up_questions", "trace_id"],
  "properties": {
    "answer": { "type": "string" },
    "language": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "quote"],
        "properties": {
          "id": { "type": "string" },
          "quote": { "type": "string" }
        }
      }
    },
    "need_human": { "type": "boolean" },
    "lead_fields": {
      "type": "object",
      "properties": {
        "product": { "type": ["string", "null"] },
        "quantity": { "type": ["string", "number", "null"] },
        "country": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "material": { "type": ["string", "null"] },
        "drawing_available": { "type": ["boolean", "null"] }
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trace_id": { "type": "string" }
  }
}
