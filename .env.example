# ============================================================
#  外贸独立站客服 Agent — 环境变量示例
#  复制为 .env 后填写： cp .env.example .env
#  注意：.env 已被 .gitignore 忽略，请勿提交真实 API key。
# ============================================================

# LLM 模式： mock | deepseek
# mock     -> 不调用任何外部 API，使用内置规则生成回答（无 key 也能跑通主流程）
# deepseek -> 调用真实 DeepSeek API（OpenAI 兼容接口）
LLM_MODE=mock

# DeepSeek 配置（仅 LLM_MODE=deepseek 时需要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名：deepseek-chat / deepseek-reasoner 等
DEEPSEEK_MODEL=deepseek-chat

# LLM 请求参数
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
# 非法 JSON 时的最大重试次数
LLM_MAX_RETRIES=2

# 检索返回的知识片段条数
RETRIEVAL_TOP_K=4
# 实义词覆盖率低于该阈值视为「知识库无相关信息」-> need_human=true
RETRIEVAL_MIN_SCORE=0.34

# 路径
KNOWLEDGE_PATH=knowledge/company_knowledge.json
LOG_PATH=logs/traces.jsonl
# 会话持久化数据库（SQLite，首次运行自动创建）
DB_PATH=data/app.db
